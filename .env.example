# ============================================================================
# FrameMind 环境配置示例
# 复制为 .env 后按需修改: Copy-Item .env.example .env
# ============================================================================

# ---------- 零成本运行路径(默认配置,无需任何付费 API Key) ----------
# 使用本地 Ollama。确保主机已安装并运行 Ollama:https://ollama.com
# 并已拉取模型,例如: ollama pull qwen2.5-coder:7b
LLM_PROVIDER=ollama
LLM_MODEL=ollama/qwen2.5-coder:7b
# host.docker.internal 用于容器访问宿主机的 Ollama 服务(Windows/Mac Docker Desktop 原生支持)
# Linux 下如无法解析,改为宿主机实际 IP,或在 compose 中加 extra_hosts
LLM_BASE_URL=http://host.docker.internal:11434
LLM_API_KEY=ollama-local-no-key-needed

# ---------- 可选:切换到付费厂商(任选其一,不填则保持零成本路径) ----------
# OpenAI 兼容端点:
# LLM_PROVIDER=openai
# LLM_MODEL=openai/gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-xxx

# Anthropic:
# LLM_PROVIDER=anthropic
# LLM_MODEL=anthropic/claude-sonnet-4-5
# LLM_API_KEY=sk-ant-xxx

# DeepSeek:
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek/deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxx

# 智谱开放平台:
# LLM_PROVIDER=zhipu
# 支持简洁名称或完整名称: "glm-5.3-flash" 或 "openai/glm-5.3-flash"
# LLM_MODEL=glm-5.3-flash
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# LLM_API_KEY=your-zhipu-api-key-here

# ---------- 数据库 ----------
# POSTGRES_USER/PASSWORD 是数据库 superuser/owner,仅用于 alembic 迁移(建表、建角色、建 RLS 策略)。
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agentforge
POSTGRES_USER=agentforge
POSTGRES_PASSWORD=change-me-in-production
# DATABASE_URL(迁移用,owner 角色):
DATABASE_URL=postgresql+asyncpg://agentforge:change-me-in-production@postgres:5432/agentforge
# APP_DATABASE_URL(业务 API/worker 用,受限角色 agentforge_app):
# Postgres 对表 owner 默认豁免 RLS 检查,业务连接必须使用非 owner 的受限角色,
# 否则 RLS 策略形同虚设。该角色由 alembic 迁移 0001 自动创建,密码见迁移脚本,
# 生产环境务必修改(迁移脚本中的 CREATE ROLE 语句,以及下面这行保持一致)。
APP_DATABASE_URL=postgresql+asyncpg://agentforge_app:change-me-in-production@postgres:5432/agentforge

# ---------- 队列 / 缓存(Valkey,BSD-3 许可,Redis 协议兼容) ----------
REDIS_URL=redis://valkey:6379/0

# ---------- 控制平面 ----------
CONTROL_PLANE_SECRET_KEY=dev-only-change-this-32-byte-secret-key-please
CONTROL_PLANE_HOST=0.0.0.0
CONTROL_PLANE_PORT=8000
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# ---------- 预算护栏默认值(可被每任务/每租户配置覆盖) ----------
DEFAULT_MAX_STEPS=50
DEFAULT_TIMEOUT_SECONDS=1800
DEFAULT_TOKEN_BUDGET=200000
DEFAULT_COST_BUDGET_USD=5.00

# ---------- 沙箱 ----------
SANDBOX_IMAGE=agentforge/sandbox-runtime:latest
# docker | microvm(预留未实现) | e2b(预留未实现)
SANDBOX_PROVIDER=docker
SANDBOX_NETWORK_MODE=bridge
DOCKER_HOST=unix:///var/run/docker.sock

# ---------- 前端 ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# ---------- 可观测 ----------
LOG_LEVEL=INFO
AUDIT_LOG_RETENTION_DAYS=90
